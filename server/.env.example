PORT=5000
CLIENT_ORIGIN=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://viraladlibrary.site,https://www.viraladlibrary.site
APIFY_TOKEN=
APIFY_TIKTOK_ACTOR=clockworks/tiktok-scraper
APIFY_TIKTOK_PROFILE_ACTOR=clockworks/tiktok-profile-scraper
APIFY_TIKTOK_TRENDS_ACTOR=clockworks/tiktok-trends-scraper
# Fallback when primary trends actor returns too few music items (< TIKTOK_MUSIC_CACHE_MIN_ITEMS)
APIFY_TIKTOK_MUSIC_FALLBACK_ACTOR=burbn/tiktok-trending-sounds
APIFY_TIKTOK_TOP_ADS_ACTOR=beyondops/tiktok-ad-library-scraper
TIKTOK_TOP_ADS_LIMIT=48
TIKTOK_TOP_ADS_MEMORY_MB=2048
TIKTOK_TOP_ADS_CACHE_TTL_HOURS=12
TIKTOK_TOP_ADS_CACHE_MIN_ITEMS=5
# Set to 1 to log first raw Apify dataset row (keys + truncated JSON) on each refresh
# TIKTOK_TOP_ADS_DEBUG_LOG=
TIKTOK_TRENDING_MUSIC_DEFAULT_COUNTRY=US
TIKTOK_TRENDING_MUSIC_LIMIT=48
TIKTOK_MUSIC_CACHE_MIN_ITEMS=5
TIKTOK_TRENDING_MUSIC_INTERVAL_MS=86400000
TIKTOK_TRENDING_MUSIC_DAILY_COUNTRIES=US
# Set to 1 to schedule daily music refresh (does NOT run on server startup — manual refresh still works)
TIKTOK_TRENDING_MUSIC_JOB_ENABLED=0
# Facebook Ad Library (default: curious_coder/facebook-ads-library-scraper)
# APIFY_FACEBOOK_ADS_ACTOR=username/other-actor-id
# Set to 1 for EU reach / extra fields (costs more Apify usage)
# Set to 1 to log a second raw Apify dataset item (verbose)
# APIFY_DEBUG_LOGS=

CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514
CLAUDE_ANALYSIS_MODEL=claude-3-5-haiku-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Clerk Backend API — same secret key as in Clerk Dashboard → API Keys
CLERK_SECRET_KEY=

# Optional: pull Firebase/GA4 funnel + event reports into admin analytics
# GA4 numeric property ID (GA Admin → Property settings — not the Firebase measurement ID)
GA4_PROPERTY_ID=
# Path to Google service account JSON with Analytics Viewer on the GA4 property
GOOGLE_APPLICATION_CREDENTIALS=
# Or inline JSON (single line) instead of GOOGLE_APPLICATION_CREDENTIALS
# GOOGLE_SERVICE_ACCOUNT_JSON=
